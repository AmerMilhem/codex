{
  "version": 1,
  "projects": {
    "web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "outputPath": "dist/web",
            "optimization": {
              "scripts": true,
              "styles": { "minify": true, "inlineCritical": false },
              "fonts": false
            },
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "400kB",
                "maximumError": "500kB"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "web:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "watch": false,
            "buildTarget": "web:build",
            "reporters": [
              "default",
              [
                "json",
                {
                  "outputFile": "../../../artifacts/web/unit-results.json"
                }
              ]
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
