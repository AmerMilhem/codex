{
  "name": "erp-web-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "format:check": "prettier --check src angular.json *.json *.mjs",
    "format": "prettier --write src angular.json *.json *.mjs",
    "test:browser": "node browser-tests.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "jsdom": "27.0.1",
    "prettier": "3.6.2"
  },
  "overrides": {
    "vite": "8.3.5",
    "fast-uri": "3.1.9"
  }
}
